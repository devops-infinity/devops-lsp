{
  "yaml": {
    "command": "yaml-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".yaml": "yaml",
      ".yml": "yaml"
    },
    "startupTimeout": 60000,
    "maxRestarts": 3,
    "settings": {
      "yaml": {
        "validate": true,
        "hover": true,
        "hoverSchemaSource": true,
        "completion": true,
        "yamlVersion": "1.2",
        "schemaStore": {
          "enable": true,
          "url": "https://www.schemastore.org/api/json/catalog.json"
        },
        "schemas": {},
        "kubernetesCRDStore": {
          "enable": true
        }
      },
      "http": {
        "proxyStrictSSL": true
      }
    }
  }
}
