{
  "shell": {
    "command": "bash-language-server",
    "args": [
      "start"
    ],
    "extensionToLanguage": {
      ".sh": "shellscript",
      ".bash": "shellscript",
      ".bats": "shellscript"
    },
    "startupTimeout": 30000,
    "maxRestarts": 3,
    "settings": {
      "bashIde": {
        "shellcheckPath": "shellcheck",
        "shellcheckArguments": [],
        "enableSourceErrorDiagnostics": false,
        "includeAllWorkspaceSymbols": false,
        "backgroundAnalysisMaxFiles": 0,
        "logLevel": "warning"
      }
    }
  }
}
